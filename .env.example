# Jarvis AI Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Settings
LLM_MODEL_PATH=models/llama-2-7b-chat.Q4_K_M.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# Memory Settings
VECTOR_DB_PATH=data/embeddings/chroma
MEMORY_DB_PATH=data/memory.db

# Redis Settings (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Settings
SESSION_SECRET_KEY=your-secret-key-change-this
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=logs/audit.log

# Policy Settings
POLICY_FILE=data/policies/policies.json
DEFAULT_TRUST_LEVEL=low
DRY_RUN_MODE=false

# Agent Settings
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# Plugin Settings
PLUGIN_DIR=plugins
ENABLE_PLUGIN_SIGNING=false

# Feature Flags
ENABLE_VOICE=false
ENABLE_PENTEST_TOOLS=false
ENABLE_CODE_EXECUTION=true
ENABLE_NETWORK_TOOLS=false
